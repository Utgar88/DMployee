<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting.
         Android shows the app icon on this color; the loading screen with
         the artwork follows in Flutter (lib/ui/startup_screen.dart). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/brand_background</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the process has started.
         Same dark color, so nothing flashes before Flutter draws. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/brand_background</item>
    </style>
</resources>
